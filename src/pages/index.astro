---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featuredPost = posts.find(p => p.data.featured);
// Only the post actually shown in the featured slot is held back — filtering
// on the flag would silently drop every other post marked `featured: true`.
const otherPosts = posts.filter(p => p !== featuredPost);

const pageTitle = "Home";
const description = "Puji's Blog: Programming, systems, and design.";
---

<BaseLayout title={pageTitle} description={description}>
  <main class="home-main">
    <section class="hero animate-fade-up">
      <div class="hero-inner">
        <h1 class="hero-title animate-fade-up delay-1">
          Notes that <em class="gradient-text">think</em><br />back at you.
        </h1>
        <p class="hero-description animate-fade-up delay-2">
          A quiet writing room for the long-form thinker — a second brain bound in restraint.
          Programming, distributed systems, and things that interest me.
        </p>
        <div class="hero-actions animate-fade-up delay-3">
          <a href="/archive/" class="btn btn-primary">Begin reading</a>
          <a href="/about/" class="btn btn-ghost">About this site</a>
        </div>
      </div>
    </section>

    {featuredPost && (
      <section class="featured glass animate-fade-up delay-2">
        <div class="featured-inner">
          <span class="featured-label">Featured</span>
          <a href={featuredPost.data.targetUrl} class="featured-link">
            <h2 class="featured-title">{featuredPost.data.title}</h2>
          </a>
          {featuredPost.data.subtitle && (
            <p class="featured-subtitle">{featuredPost.data.subtitle}</p>
          )}
          <p class="featured-summary">{featuredPost.data.summary}</p>
          <time class="featured-date">
            {new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(featuredPost.data.publishedAt)}
          </time>
        </div>
      </section>
    )}

    <section class="post-grid">
      {otherPosts.map(post => (
         <article class="post-card glass animate-fade-up">
           <time class="post-card-date">
            {new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(post.data.publishedAt)}
          </time>
          <a href={post.data.targetUrl} class="post-card-link">
            <h3 class="post-card-title">{post.data.title}</h3>
          </a>
          {post.data.subtitle && <p class="post-card-subtitle">{post.data.subtitle}</p>}
          <p class="post-card-summary">{post.data.summary}</p>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .home-main {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-8) var(--spacing-5);
  }

  .hero {
    margin-bottom: var(--spacing-12);
  }

  .hero-inner {
    max-width: 640px;
  }

  .hero-title {
    font-family: var(--font-sans);
    font-size: var(--text-4xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0 0 var(--spacing-6) 0;
    letter-spacing: -0.02em;
  }

  .hero-title em {
    font-style: italic;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }

  .hero-description {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 52ch;
    margin: 0 0 var(--spacing-6) 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-2) var(--spacing-4);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    cursor: pointer;
    border: none;
    position: relative;
    overflow: hidden;
  }

  .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: var(--color-surface);
    color: var(--color-fg-muted);
    border: 0.5px solid var(--color-border);
  }

  .btn-ghost:hover {
    background: var(--color-surface-hover);
    color: var(--color-fg);
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  html[data-theme="dark"] .btn-primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  html[data-theme="dark"] .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
  }

  html[data-theme="dark"] .btn-ghost {
    background: var(--color-surface);
    color: var(--color-fg-muted);
  }

  html[data-theme="dark"] .btn-ghost:hover {
    background: var(--color-surface-hover);
    color: var(--color-fg);
  }

  .featured {
    margin-bottom: var(--spacing-12);
    padding: var(--spacing-8);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .featured:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
  }

  html[data-theme="dark"] .featured:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
  }

  .featured-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--spacing-3);
  }

  .featured-link {
    text-decoration: none;
    color: inherit;
  }

  .featured-link:hover {
    text-decoration: none;
  }

  .featured-title {
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg);
    margin: 0 0 var(--spacing-2) 0;
    transition: color var(--transition-fast);
  }

  .featured-link:hover .featured-title {
    color: var(--color-accent);
  }

  .featured-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-fg-muted);
    margin: 0 0 var(--spacing-3) 0;
  }

  .featured-summary {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
    margin: 0 0 var(--spacing-4) 0;
  }

  .featured-date {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
  }

  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-6);
  }

  @media (min-width: 640px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-6);
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: var(--spacing-5);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .post-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
  }

  html[data-theme="dark"] .post-card:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
  }

  .post-card-date {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
  }

  .post-card-link {
    text-decoration: none;
    color: inherit;
  }

  .post-card-link:hover {
    text-decoration: none;
  }

  .post-card-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .post-card-link:hover .post-card-title {
    color: var(--color-accent);
  }

  .post-card-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .post-card-summary {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
    margin: var(--spacing-2) 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
