---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featuredPost = posts.find(p => p.data.featured);
const otherPosts = posts.filter(p => !p.data.featured);

const pageTitle = "Home";
const description = "Puji's Blog: Programming, systems, and design.";
---

<BaseLayout title={pageTitle} description={description}>
  <main class="home-main">
    <!-- Hero Section -->
    <section class="hero animate-fade-up">
      <div class="hero-inner">
        <p class="hero-eyebrow animate-fade-up delay-1">Volume I — A Manual for Thought</p>
        <h1 class="hero-title animate-fade-up delay-2">
          Notes that <em>think</em><br />back at you.
        </h1>
        <p class="hero-description animate-fade-up delay-3">
          A quiet writing room for the long-form thinker — a second brain bound in restraint.
          Programming, distributed systems, and things that interest me.
        </p>
        <div class="hero-actions animate-fade-up delay-4">
          <a href="/archive/" class="btn btn-primary">Begin reading</a>
          <a href="/about/" class="btn btn-ghost">About this site</a>
        </div>
      </div>
    </section>

    <!-- Featured Post -->
    {featuredPost && (
      <section class="featured animate-fade-up delay-2">
        <div class="featured-inner">
          <span class="featured-label">Featured</span>
          <a href={featuredPost.data.targetUrl} class="featured-link">
            <h2 class="featured-title">{featuredPost.data.title}</h2>
          </a>
          {featuredPost.data.subtitle && (
            <p class="featured-subtitle">{featuredPost.data.subtitle}</p>
          )}
          <p class="featured-summary">{featuredPost.data.summary}</p>
          <time class="featured-date">
            {new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(featuredPost.data.publishedAt)}
          </time>
        </div>
      </section>
    )}

    <!-- Post Grid -->
    <section class="post-grid">
      {otherPosts.map(post => (
         <article class="post-card card-hover animate-fade-up">
           <time class="post-card-date">
            {new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(post.data.publishedAt)}
          </time>
          <a href={post.data.targetUrl} class="post-card-link">
            <h3 class="post-card-title">{post.data.title}</h3>
          </a>
          {post.data.subtitle && <p class="post-card-subtitle">{post.data.subtitle}</p>}
          <p class="post-card-summary">{post.data.summary}</p>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .home-main {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-8) var(--spacing-5);
  }

  /* ---------- Hero ---------- */
  .hero {
    margin-bottom: var(--spacing-12);
  }

  .hero-inner {
    max-width: 720px;
  }

  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-fg-muted);
    margin-bottom: var(--spacing-5);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0 0 var(--spacing-6) 0;
  }

  .hero-title em {
    font-style: italic;
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }

  .hero-description {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 52ch;
    margin: 0 0 var(--spacing-6) 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-5);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: var(--spacing-3) var(--spacing-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: all var(--transition-fast);
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-fg-muted);
    border: 1px solid var(--color-border);
  }

  .btn-ghost:hover {
    color: var(--color-fg);
    border-color: var(--color-fg-muted);
    text-decoration: none;
  }

  /* ---------- Featured ---------- */
  .featured {
    margin-bottom: var(--spacing-12);
    padding: var(--spacing-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
  }

  .featured:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-light);
  }

  .featured-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--spacing-4);
  }

  .featured-link {
    text-decoration: none;
    color: inherit;
  }

  .featured-link:hover {
    text-decoration: none;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg);
    margin: 0 0 var(--spacing-3) 0;
    transition: color var(--transition-fast);
  }

  .featured-link:hover .featured-title {
    color: var(--color-accent);
  }

  .featured-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-fg-muted);
    margin: 0 0 var(--spacing-4) 0;
  }

  .featured-summary {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--spacing-5) 0;
  }

  .featured-date {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
  }

  /* ---------- Post Grid ---------- */
  .post-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-8);
  }

  @media (min-width: 640px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-8) var(--spacing-6);
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding-top: var(--spacing-5);
    border-top: 1px solid var(--color-border);
  }

  .post-card-date {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-fg-subtle);
  }

  .post-card-link {
    text-decoration: none;
    color: inherit;
  }

  .post-card-link:hover {
    text-decoration: none;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--color-fg);
    margin: 0;
    transition: color var(--transition-fast);
  }

  .post-card-link:hover .post-card-title {
    color: var(--color-accent);
  }

  .post-card-subtitle {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-style: italic;
    color: var(--color-fg-muted);
    margin: 0;
  }

  .post-card-summary {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    line-height: var(--leading-normal);
    margin: var(--spacing-2) 0 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
