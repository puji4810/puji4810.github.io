---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Group by Year -> Month
const grouped = posts.reduce((acc, post) => {
  const date = post.data.publishedAt;
  const year = date.getUTCFullYear();
  const month = new Intl.DateTimeFormat("en-US", { month: "long", timeZone: "UTC" }).format(date);
  
  if (!acc[year]) acc[year] = {};
  if (!acc[year][month]) acc[year][month] = [];
  
  acc[year][month].push(post);
  return acc;
}, {} as Record<number, Record<string, typeof posts>>);

const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);

const pageTitle = "Archive";
const description = "All articles organized by date.";
---

<BaseLayout title={pageTitle} description={description}>
  <main style="max-width: 800px; margin: 0 auto; padding: var(--spacing-6) var(--spacing-4);">
    <header style="margin-bottom: var(--spacing-6);">
      <h1 style="font-family: var(--font-serif); font-size: 3rem; margin: 0;">Archive</h1>
      <p style="font-family: var(--font-sans); font-size: 1.1rem; opacity: 0.8; margin-top: var(--spacing-2);">
        {posts.length} articles across {years.length} years.
      </p>
    </header>

    <div style="display: flex; flex-direction: column; gap: var(--spacing-8);">
      {years.map(year => (
        <section>
          <h2 style="font-family: var(--font-sans); font-size: 2rem; border-bottom: 2px solid var(--color-border); padding-bottom: var(--spacing-2); margin-top: 0; margin-bottom: var(--spacing-4);">
            {year}
          </h2>
          
          <div style="display: flex; flex-direction: column; gap: var(--spacing-5);">
            {Object.entries(grouped[year]).map(([month, monthPosts]) => (
              <div>
                <h3 style="font-family: var(--font-sans); font-size: 1.2rem; color: var(--color-accent); margin-top: 0; margin-bottom: var(--spacing-3);">
                  {month}
                </h3>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--spacing-3);">
                  {monthPosts.map(post => (
                    <li style="display: flex; flex-direction: column; gap: var(--spacing-1);">
                      <a href={post.data.targetUrl} style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-fg); text-decoration: none; font-weight: bold;">
                        {post.data.title}
                      </a>
                      <div style="font-family: var(--font-sans); font-size: 0.9em; opacity: 0.7;">
                        {new Intl.DateTimeFormat("en-US", { day: "numeric", month: "short", timeZone: "UTC" }).format(post.data.publishedAt)}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
