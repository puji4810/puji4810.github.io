---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "About";
const description = "About the author.";
---

<BaseLayout title={pageTitle} description={description}>
  <main class="about-main">
    <header class="about-header">
      <h1>About</h1>
    </header>

    <article class="about-content">
      <p class="about-lead">
        Hi, I'm <strong>Puji</strong>. Welcome to my blog.
      </p>
      <p>
        I write about programming, distributed systems, software engineering, and things that interest me.
        This site is a collection of my thoughts, learnings, and experiences — a quiet writing room bound in restraint.
      </p>
      <p>
        Every note is an argument. Every argument is a building block for new thought.
      </p>
    </article>
  </main>
</BaseLayout>

<style>
  .about-main {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--spacing-8) var(--spacing-5);
  }

  .about-header {
    margin-bottom: var(--spacing-8);
    padding-bottom: var(--spacing-6);
    border-bottom: 1px solid var(--color-border);
  }

  .about-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 600;
    margin: 0;
  }

  .about-content {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-fg);
  }

  .about-content p {
    margin: 0 0 var(--spacing-5) 0;
  }

  .about-lead {
    font-size: var(--text-xl);
    color: var(--color-fg);
  }

  .about-content strong {
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
