---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

const tagsMap = posts.reduce((acc, post) => {
  const tags = post.data.tags || [];
  tags.forEach(tag => {
    if (!acc[tag]) acc[tag] = [];
    acc[tag].push(post);
  });
  return acc;
}, {} as Record<string, typeof posts>);

const sortedTags = Object.keys(tagsMap).sort((a, b) => a.localeCompare(b));

const pageTitle = "Tags";
const description = "All tags from my articles.";
---

<BaseLayout title={pageTitle} description={description}>
  <main class="tags-main">
    <header class="tags-header">
      <h1>Tags</h1>
      <p class="tags-meta">{sortedTags.length} topics explored.</p>
    </header>

    <div class="tags-content">
      {sortedTags.map(tag => {
        const tagPosts = tagsMap[tag].sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
        return (
          <section class="tag-section" id={tag.toLowerCase().replace(/\s+/g, '-')}>
            <h2 class="tag-name">#{tag}</h2>
            <ul class="tag-posts">
              {tagPosts.map(post => (
                <li class="tag-post">
                  <a href={post.data.targetUrl} class="tag-post-link">
                    {post.data.title}
                  </a>
                  <time class="tag-post-date">
                    {new Intl.DateTimeFormat("en-US", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(post.data.publishedAt)}
                  </time>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </main>
</BaseLayout>

<style>
  .tags-main {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--spacing-8) var(--spacing-5);
  }

  .tags-header {
    margin-bottom: var(--spacing-10);
    padding-bottom: var(--spacing-6);
    border-bottom: 1px solid var(--color-border);
  }

  .tags-header h1 {
    font-family: var(--font-sans);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin: 0 0 var(--spacing-3) 0;
    letter-spacing: -0.02em;
  }

  .tags-meta {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    margin: 0;
  }

  .tags-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-10);
  }

  .tag-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .tag-name {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
    padding-bottom: var(--spacing-3);
    border-bottom: 1px solid var(--color-border);
    letter-spacing: -0.02em;
  }

  .tag-posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .tag-post {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-4);
    padding-bottom: var(--spacing-3);
    border-bottom: 1px solid var(--color-border-light);
  }

  .tag-post:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .tag-post-link {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-fg);
    text-decoration: none;
    transition: color var(--transition-fast);
    flex: 1;
  }

  .tag-post-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .tag-post-date {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-fg-subtle);
    white-space: nowrap;
  }
</style>
