---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404 - Page Not Found";
const description = "The page you were looking for could not be found.";
---

<BaseLayout title={pageTitle} description={description}>
  <main style="max-width: 800px; margin: 0 auto; padding: var(--spacing-6) var(--spacing-4); text-align: center;">
    <h1 style="font-family: var(--font-sans); font-size: 4rem; margin: 0 0 var(--spacing-2); opacity: 0.3; font-weight: 700;">
      404
    </h1>
    <p style="font-family: var(--font-sans); font-size: 1.5rem; margin: 0 0 var(--spacing-3); font-weight: 600;">
      Page Not Found
    </p>
    <p style="font-family: var(--font-sans); font-size: 1.05rem; opacity: 0.75; max-width: 500px; margin: 0 auto var(--spacing-6); line-height: 1.7;">
      The page you were looking for may have moved or no longer exists.
    </p>
    <nav style="display: flex; gap: var(--spacing-4); justify-content: center; flex-wrap: wrap; font-family: var(--font-sans);">
      <a href="/" style="color: var(--color-accent); text-decoration: none; padding: var(--spacing-2) var(--spacing-4); border: 1px solid var(--color-border);">
        Home
      </a>
      <a href="/archive/" style="color: var(--color-fg); text-decoration: none; padding: var(--spacing-2) var(--spacing-4); border: 1px solid var(--color-border);">
        Archive
      </a>
      <a href="/tags/" style="color: var(--color-fg); text-decoration: none; padding: var(--spacing-2) var(--spacing-4); border: 1px solid var(--color-border);">
        Tags
      </a>
      <a href="/about/" style="color: var(--color-fg); text-decoration: none; padding: var(--spacing-2) var(--spacing-4); border: 1px solid var(--color-border);">
        About
      </a>
    </nav>
  </main>
</BaseLayout>
