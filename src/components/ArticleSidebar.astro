---
interface Post {
  data: {
    title: string;
    publishedAt: Date;
    targetUrl: string;
  };
}

interface Props {
  posts: Post[];
  currentUrl: string;
}

const { posts, currentUrl } = Astro.props;

const postsByYear = posts.reduce((acc, post) => {
  const year = post.data.publishedAt.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, Post[]>);

const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);
---

<nav aria-label="Article navigation">
  <button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-expanded="false" aria-controls="sidebar-nav-content">
    <span class="toggle-icon">☰</span>
    <span class="toggle-label">Articles</span>
  </button>
  <div id="sidebar-nav-content" class="layout-sidebar-content">
    <ul class="sidebar-list">
      {years.map(year => (
        <li class="sidebar-year-group">
          <div class="sidebar-year">{year}</div>
          <ul class="sidebar-posts">
            {postsByYear[year].map(post => {
              const isCurrent = post.data.targetUrl === currentUrl;
              return (
                <li>
                  <a
                    href={post.data.targetUrl}
                    class={`sidebar-link ${isCurrent ? 'active' : ''}`}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {post.data.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .sidebar-list,
  .sidebar-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-year-group {
    margin-bottom: var(--spacing-5);
  }

  .sidebar-year-group:last-child {
    margin-bottom: 0;
  }

  .sidebar-year {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    margin-bottom: var(--spacing-3);
    padding-bottom: var(--spacing-2);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-posts {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  .sidebar-link {
    display: block;
    padding: var(--spacing-1) 0;
    color: var(--color-fg-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    transition: color var(--transition-fast);
    border-left: 2px solid transparent;
    padding-left: var(--spacing-2);
    margin-left: calc(-1 * var(--spacing-2));
  }

  .sidebar-link:hover {
    color: var(--color-accent);
    text-decoration: none;
    border-left-color: var(--color-border);
  }

  .sidebar-link.active {
    color: var(--color-accent);
    font-weight: 500;
    border-left-color: var(--color-accent);
  }

  .toggle-icon {
    font-size: var(--text-sm);
  }

  .toggle-label {
    font-size: var(--text-sm);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
    });
  }
</script>
