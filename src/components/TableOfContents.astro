---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

/** Sticky rail for wide screens. Narrow screens get TocFab instead. */
interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth >= 1 && h.depth <= 3);

// Indent relative to the shallowest heading present, so posts that start at
// `##` are not pushed in just because other posts use `#`.
const minDepth = filteredHeadings.length
  ? Math.min(...filteredHeadings.map(h => h.depth))
  : 1;
---

{filteredHeadings.length > 0 && (
  <details class="toc toc-rail" open>
    <summary class="toc-summary">
      <span class="toc-summary-label" lang="en">On this page</span>
      <span class="toc-summary-count">{filteredHeadings.length}</span>
    </summary>
    <nav aria-label="Table of contents">
      <ul class="toc-list">
        {filteredHeadings.map(heading => (
          <li class={`toc-item level-${heading.depth - minDepth}`}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </details>
)}

<style>
  .toc-rail {
    padding-top: var(--spacing-2);
  }

  .toc-summary {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    list-style: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-summary:hover {
    color: var(--color-accent);
  }

  .toc-summary-label {
    flex: 1;
  }

  .toc-summary-count {
    font-variant-numeric: tabular-nums;
    font-weight: 400;
    color: var(--color-fg-subtle);
  }

  /* Chevron rotates to point down once the list is open. */
  .toc-summary::after {
    content: "";
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--transition-fast);
  }

  .toc[open] > .toc-summary::after {
    transform: rotate(45deg);
  }

  .toc-rail > .toc-summary {
    margin-bottom: var(--spacing-4);
    padding-bottom: var(--spacing-3);
    border-bottom: 1px solid var(--color-border);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1.5px solid var(--color-border);
  }

  .toc-item {
    margin-bottom: var(--spacing-1);
  }

  .toc-item.level-1 {
    padding-left: var(--spacing-3);
  }

  .toc-item.level-2 {
    padding-left: var(--spacing-5);
  }

  .toc-item.level-0 > .toc-link {
    color: var(--color-fg);
    font-weight: 500;
  }

  .toc-link {
    display: block;
    padding: var(--spacing-1) var(--spacing-3);
    color: var(--color-fg-muted);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    border-left: 1.5px solid transparent;
    margin-left: -1.5px;
  }

  .toc-link:hover,
  .toc-link:focus {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    text-decoration: none;
  }

  /* Set by the scroll-spy below; marks the section currently being read.
     Must out-rank `.toc-item.level-0 > .toc-link` above, which is also three
     classes — otherwise top-level entries never show as active. */
  .toc-item > .toc-link.is-active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
  }
</style>

<script>
  // Highlights the heading currently under the reading line, and keeps that
  // entry visible inside its own scrollport without scrolling the page. Runs
  // once for every list on the page — the rail and the mobile sheet share it.
  function initTocScrollSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-link")
    );
    if (links.length === 0) return;

    // A heading appears in both the rail and the mobile sheet, so group the
    // links by target. Slugs are percent-encoded in `hash` (posts use CJK).
    const linksBySlug = new Map<string, HTMLAnchorElement[]>();
    for (const link of links) {
      const slug = decodeURIComponent(link.hash.slice(1));
      if (!slug) continue;
      const group = linksBySlug.get(slug);
      if (group) group.push(link);
      else linksBySlug.set(slug, [link]);
    }

    const targets = Array.from(linksBySlug.keys())
      .map(slug => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) return;

    const headerHeight =
      document.querySelector(".post-page-header")?.getBoundingClientRect()
        .height ?? 0;
    // Sits just below where `scroll-margin-top` parks a heading after an
    // anchor jump. Without the slack a heading landing a fraction of a pixel
    // short of the line leaves the *previous* entry highlighted, so clicking
    // an entry appears to do nothing.
    const readingLine = headerHeight + 24 + 8;

    let activeSlug: string | null = null;

    function setActive(slug: string) {
      if (slug === activeSlug) return;
      if (activeSlug) {
        for (const link of linksBySlug.get(activeSlug) ?? []) {
          link.classList.remove("is-active");
          link.removeAttribute("aria-current");
        }
      }
      activeSlug = slug;
      for (const link of linksBySlug.get(slug) ?? []) {
        link.classList.add("is-active");
        link.setAttribute("aria-current", "location");
        revealInList(link);
      }
    }

    // Nudge the list's own scrollport, never the document. The sheet is only
    // scrolled while it is open — moving a hidden list would be wasted work,
    // and its box has no height to measure against.
    function revealInList(link: HTMLAnchorElement) {
      const port = link.closest<HTMLElement>(".layout-toc, .toc-sheet-body");
      if (!port || port.clientHeight === 0) return;
      if (port.scrollHeight <= port.clientHeight) return;
      const portBox = port.getBoundingClientRect();
      const linkBox = link.getBoundingClientRect();
      if (linkBox.top >= portBox.top && linkBox.bottom <= portBox.bottom) return;
      port.scrollTop +=
        linkBox.top - portBox.top - port.clientHeight / 2 + linkBox.height / 2;
    }

    function update() {
      // The last heading that has crossed the reading line wins; before the
      // first one crosses, the first heading stays selected.
      let current = targets[0];
      for (const target of targets) {
        if (target.getBoundingClientRect().top > readingLine) break;
        current = target;
      }
      // At the very bottom the last section can never cross the line on its
      // own, so claim it explicitly.
      const atBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      if (atBottom) current = targets[targets.length - 1];
      setActive(current.id);
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  }

  initTocScrollSpy();
</script>
