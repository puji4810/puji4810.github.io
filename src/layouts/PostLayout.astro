---
import "../styles/theme.css";
import "../styles/rendering.css";
import "../styles/layout.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import ArticleSidebar from "../components/ArticleSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import PostFooterNav from "../components/PostFooterNav.astro";
import fs from 'node:fs';
import path from 'node:path';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Post {
  data: {
    title: string;
    publishedAt: Date;
    targetUrl: string;
  };
}

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  publishedAt: Date;
  headings: Heading[];
  posts: Post[];
  currentUrl: string;
  tags?: string[];
  showToc?: boolean;
  readingMinutes: number;
  older?: { title: string; targetUrl: string };
  newer?: { title: string; targetUrl: string };
  /** Language of the article body; the surrounding chrome stays English. */
  contentLang: string;
}

const {
  title,
  subtitle,
  description,
  publishedAt,
  headings,
  posts,
  currentUrl,
  tags = [],
  showToc = true,
  readingMinutes,
  older,
  newer,
  contentLang,
} = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(publishedAt);
const isoDate = publishedAt.toISOString();
const tagAnchor = (tag: string) => `/tags/#${tag.toLowerCase().replace(/\s+/g, "-")}`;

const themeScript = fs.readFileSync(path.join(process.cwd(), 'src/scripts/theme-boot.js'), 'utf-8');
---

<!doctype html>
<html lang={contentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Puji's Blog"
      href={new URL("feed.xml", Astro.site).href}
    />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <div class="ambient-glow" aria-hidden="true"></div>
    <header class="post-page-header" lang="en">
      <div class="post-page-header-inner">
        <a href="/" class="post-home-link">← Home</a>
        <ThemeToggle />
      </div>
      <ReadingProgress />
    </header>

    <div class="layout-container">
      <aside class="layout-sidebar">
        <ArticleSidebar posts={posts} currentUrl={currentUrl} />
      </aside>

      <main class="layout-content render-shell" data-pagefind-body>
        <header class="render-header">
          <p class="post-meta">
            <time datetime={isoDate}>{formattedDate}</time>
            <span class="post-meta-sep" aria-hidden="true">·</span>
            <span>{readingMinutes} min read</span>
          </p>
          <h1>{title}</h1>
          {subtitle && <p class="post-subtitle">{subtitle}</p>}
          {tags.length > 0 && (
            <ul class="post-tags" aria-label="Tags">
              {tags.map(tag => (
                <li>
                  <a href={tagAnchor(tag)} class="tag-pill">#{tag}</a>
                </li>
              ))}
            </ul>
          )}
        </header>
        {showToc && (
          <div data-pagefind-ignore>
            <TableOfContents headings={headings} variant="inline" />
          </div>
        )}
        <article class="render-prose">
          <slot />
        </article>
        <div data-pagefind-ignore>
          <PostFooterNav older={older} newer={newer} />
        </div>
      </main>

      <aside class="layout-toc">
        {showToc && <TableOfContents headings={headings} />}
      </aside>
    </div>

    <script>
      import "../scripts/mermaid";
    </script>
  </body>
</html>

<style>
  .post-page-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    border-bottom: 0.5px solid var(--color-border);
    backdrop-filter: blur(16px) saturate(1.1);
    -webkit-backdrop-filter: blur(16px) saturate(1.1);
    background-color: rgba(250, 247, 242, 0.78);
    margin-bottom: var(--spacing-8);
  }

  html[data-theme="dark"] .post-page-header {
    background-color: rgba(26, 24, 20, 0.78);
    border-bottom-color: var(--color-border);
  }

  .post-page-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--spacing-4) var(--spacing-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .post-home-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-home-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .post-page-header-inner {
      padding: var(--spacing-4) var(--spacing-6);
    }
  }
</style>
