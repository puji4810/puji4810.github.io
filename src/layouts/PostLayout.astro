---
import "../styles/theme.css";
import "../styles/rendering.css";
import "../styles/layout.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import ArticleSidebar from "../components/ArticleSidebar.astro";
import TableOfContents from "../components/TableOfContents.astro";
import fs from 'node:fs';
import path from 'node:path';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Post {
  data: {
    title: string;
    publishedAt: Date;
    targetUrl: string;
  };
}

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  publishedAt: Date;
  headings: Heading[];
  posts: Post[];
  currentUrl: string;
}

const { title, subtitle, description, publishedAt, headings, posts, currentUrl } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(publishedAt);

const themeScript = fs.readFileSync(path.join(process.cwd(), 'src/scripts/theme-boot.js'), 'utf-8');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />

    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <header class="post-page-header">
      <div class="post-page-header-inner">
        <a href="/" class="post-home-link">← Home</a>
        <ThemeToggle />
      </div>
    </header>

    <div class="layout-container">
      <aside class="layout-sidebar">
        <ArticleSidebar posts={posts} currentUrl={currentUrl} />
      </aside>

      <main class="layout-content render-shell">
        <header class="render-header">
          <p class="post-date">{formattedDate}</p>
          <h1>{title}</h1>
          {subtitle && <p class="post-subtitle">{subtitle}</p>}
        </header>
        <article class="render-prose">
          <slot />
        </article>
      </main>

      <aside class="layout-toc">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <script>
      import "../scripts/mermaid";
    </script>
  </body>
</html>

<style>
  .post-page-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
    background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
    margin-bottom: var(--spacing-8);
  }

  .post-page-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--spacing-4) var(--spacing-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .post-home-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: color var(--transition-fast);
  }

  .post-home-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .post-page-header-inner {
      padding: var(--spacing-4) var(--spacing-6);
    }
  }
</style>
