---
import "../styles/theme.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A blog" } = Astro.props;
const themeScript = fs.readFileSync(path.join(process.cwd(), 'src/scripts/theme-boot.js'), 'utf-8');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline set:html={themeScript}></script>
  </head>
  <body>
    <div class="ambient-glow" aria-hidden="true"></div>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand">
          <a href="/" class="brand-link">Puji</a>
          <nav class="header-nav" aria-label="Main navigation">
            <a href="/archive/">Archive</a>
            <a href="/tags/">Tags</a>
            <a href="/about/">About</a>
          </nav>
        </div>
        <ThemeToggle />
      </div>
    </header>
    <slot />
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    background-color: rgba(255, 255, 255, 0.72);
  }

  html[data-theme="dark"] .site-header {
    background-color: rgba(6, 11, 20, 0.65);
    border-bottom-color: rgba(120, 150, 190, 0.1);
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: var(--spacing-4) var(--spacing-5);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .brand-link {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-fg);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: var(--spacing-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .header-nav a {
    color: var(--color-fg-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
  }

  .header-nav a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (min-width: 640px) {
    .header-nav {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: var(--spacing-4) var(--spacing-6);
    }
  }
</style>
